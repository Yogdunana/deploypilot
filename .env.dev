# DeployPilot Development Environment
# Copy this file to .env.dev and customize as needed
# This file is safe to commit — it uses development-only defaults

# ─── Database (PostgreSQL via docker-compose.dev.yml) ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=deploypilot
DB_PASSWORD=deploypilot_dev
DB_NAME=deploypilot

# ─── Redis ──────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ─── Server ─────────────────────────────────────────────
GIN_MODE=debug
PORT=8080

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=

# ─── Encryption ─────────────────────────────────────────
# Generate a stable key for dev: openssl rand -base64 32
# DEPLOYPILOT_ENCRYPTION_KEY=

# ─── Logging ────────────────────────────────────────────
DEPLOYPILOT_LOG_LEVEL=debug
DEPLOYPILOT_LOG_FORMAT=console
