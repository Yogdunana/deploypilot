# DeployPilot Development Environment
# Copy this file to .env.dev and customize as needed
# This file is safe to commit — it uses development-only defaults

# ─── Server ─────────────────────────────────────────────
DEPLOYPILOT_SERVER_HOST=0.0.0.0
DEPLOYPILOT_SERVER_PORT=8080

# ─── Database (PostgreSQL via docker-compose.dev.yml) ──
DEPLOYPILOT_DATABASE_TYPE=postgres
DEPLOYPILOT_DATABASE_DSN=host=localhost port=5432 user=deploypilot password=deploypilot_dev dbname=deploypilot sslmode=disable

# ─── Redis ──────────────────────────────────────────────
DEPLOYPILOT_REDIS_ADDR=localhost:6379

# ─── Auth ───────────────────────────────────────────────
# JWT secret is injected via DEPLOYPILOT_AUTH_JWT_SECRET or config file.
# For dev, leave empty and let the config file provide it.

# ─── Encryption ─────────────────────────────────────────
# Generate a stable key for dev: openssl rand -base64 32
# DEPLOYPILOT_ENCRYPTION_KEY=

# ─── Logging ────────────────────────────────────────────
DEPLOYPILOT_LOG_LEVEL=debug
DEPLOYPILOT_LOG_FORMAT=console

# ─── Environment ────────────────────────────────────────
DEPLOYPILOT_ENV=development
