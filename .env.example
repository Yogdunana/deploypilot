# DeployPilot Configuration
# Copy this file to .env and fill in your values

# ─── REQUIRED ───────────────────────────────────────────────
# JWT secret for signing tokens (min 16 characters)
# Generate: openssl rand -base64 24
JWT_SECRET=change-me-to-a-random-string-at-least-16-chars

# ─── Server ─────────────────────────────────────────────────
DEPLOYPILOT_SERVER_HOST=0.0.0.0
DEPLOYPILOT_SERVER_PORT=8080

# ─── Database ───────────────────────────────────────────────
DEPLOYPILOT_DATABASE_TYPE=sqlite
DEPLOYPILOT_DATABASE_DSN=./data/deploypilot.db

# ─── Auth ───────────────────────────────────────────────────
# JWT token expiration (default: 24h)
DEPLOYPILOT_AUTH_TOKEN_EXPIRE=24h

# ─── Redis (optional, for Pub/Sub and token blacklist) ─────
# DEPLOYPILOT_REDIS_ADDR=localhost:6379
# DEPLOYPILOT_REDIS_PASSWORD=

# ─── Encryption ─────────────────────────────────────────────
# AES-256 key for encrypting stored credentials
# Generate: openssl rand -base64 32
# Auto-generated on first run if not set (credentials lost on restart)
# DEPLOYPILOT_ENCRYPTION_KEY=

# ─── Logging ────────────────────────────────────────────────
DEPLOYPILOT_LOG_LEVEL=info
DEPLOYPILOT_LOG_FORMAT=json

# ─── Security ───────────────────────────────────────────────
# Rate limiting (requests per minute per role)
# DEPLOYPILOT_SECURITY_RATE_LIMIT_DEFAULT=100
# DEPLOYPILOT_SECURITY_RATE_LIMIT_OWNER=200

# ─── OAuth (optional) ───────────────────────────────────────
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_PROVIDER=github
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_CLIENT_ID=
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_CLIENT_SECRET=
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_REDIRECT_URL=

# ─── Audit (optional) ───────────────────────────────────────
# DEPLOYPILOT_AUDIT_EXTERNAL_LOG_PATH=./logs/audit.jsonl
