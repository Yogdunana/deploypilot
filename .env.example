# DeployPilot Configuration
# Copy this file to .env and fill in your values

# ─── REQUIRED ───────────────────────────────────────────────
# JWT secret for signing tokens (min 16 characters)
# Generate: openssl rand -base64 24
JWT_SECRET=
# IMPORTANT: Set a strong random string (at least 16 characters) before running

# ─── Server ─────────────────────────────────────────────────
DEPLOYPILOT_SERVER_HOST=0.0.0.0
DEPLOYPILOT_SERVER_PORT=8080

# ─── Database ───────────────────────────────────────────────
DEPLOYPILOT_DATABASE_TYPE=sqlite
DEPLOYPILOT_DATABASE_DSN=./data/deploypilot.db

# ─── Auth ───────────────────────────────────────────────────
# JWT token expiration (default: 24h)
DEPLOYPILOT_AUTH_TOKEN_EXPIRE=24h

# ─── Redis (optional, for Pub/Sub and token blacklist) ─────
# DEPLOYPILOT_REDIS_ADDR=localhost:6379
# DEPLOYPILOT_REDIS_PASSWORD=

# ─── Encryption ─────────────────────────────────────────────
# AES-256 key for encrypting stored credentials
# Generate: openssl rand -base64 32
# Auto-generated on first run if not set (credentials lost on restart)
# DEPLOYPILOT_ENCRYPTION_KEY=

# ─── Logging ────────────────────────────────────────────────
DEPLOYPILOT_LOG_LEVEL=info
DEPLOYPILOT_LOG_FORMAT=json

# ─── Security ───────────────────────────────────────────────
# Rate limiting (requests per minute per role)
# DEPLOYPILOT_SECURITY_RATE_LIMIT_DEFAULT=100
# DEPLOYPILOT_SECURITY_RATE_LIMIT_OWNER=200

# ─── OAuth (optional) ───────────────────────────────────────
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_PROVIDER=github
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_CLIENT_ID=
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_CLIENT_SECRET=
# DEPLOYPILOT_AUTH_OAUTH_PROVIDERS_0_REDIRECT_URL=

# ─── Audit (optional) ───────────────────────────────────────
# DEPLOYPILOT_AUDIT_EXTERNAL_LOG_PATH=./logs/audit.jsonl

# ─── SSH ────────────────────────────────────────────────────
# Default SSH username for remote deployments (fallback when server username is not set)
# DEPLOYPILOT_SSH_DEFAULT_USER=root

# ─── WebSocket ──────────────────────────────────────────────
# Allowed WebSocket origins (comma-separated); empty = same-origin only
# DEPLOYPILOT_WS_ALLOWED_ORIGINS=

# ─── Environment ────────────────────────────────────────────
# Application environment mode; "development" enables debug routes
# DEPLOYPILOT_ENV=production

# ─── CSP ────────────────────────────────────────────────────
# Content-Security-Policy header value; empty = secure default
# DEPLOYPILOT_CSP_POLICY=

# ─── HSTS ───────────────────────────────────────────────────
# HSTS max-age in seconds (default: 31536000 = 1 year)
# DEPLOYPILOT_HSTS_MAX_AGE=31536000

# ─── MCP Sandbox ────────────────────────────────────────────
# Allowed volume root paths for MCP tools (colon-separated)
# DEPLOYPILOT_ALLOWED_VOLUME_ROOTS=

# ─── Container Registries ───────────────────────────────────
# Allowed container image registries (comma-separated)
# DEPLOYPILOT_ALLOWED_REGISTRIES=

# ─── Data Directory ─────────────────────────────────────────
# Directory for persistent application data (encryption keys, etc.)
# DEPLOYPILOT_DATA_DIR=./data

# ─── License ────────────────────────────────────────────────
# License key for activation (alternative to config file)
# DEPLOYPILOT_LICENSE_KEY=
