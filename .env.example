# Deploypilot Configuration
# Copy this file to .env and fill in your values

# Database
DB_TYPE=sqlite
DB_PATH=./deploypilot.db

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# MCP
MCP_TRANSPORT=stdio

# Logging
LOG_LEVEL=info

# Encryption (auto-generated on first run)
# ENCRYPTION_KEY=

# Cloudflare DNS (optional)
# CF_API_TOKEN=
# CF_ZONE_ID=

# Notification (optional)
# WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
