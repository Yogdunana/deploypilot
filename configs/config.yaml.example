# DeployPilot Configuration
# Copy this file to config.yaml and customize as needed

server:
  host: 0.0.0.0
  port: 8080
  cors_allowed_origins:
    - "*"

database:
  type: sqlite
  dsn: ./data/deploypilot.db
  # For PostgreSQL:
  # type: postgres
  # dsn: host=localhost port=5432 user=deploypilot password=secret dbname=deploypilot sslmode=disable

redis:
  addr: localhost:6379
  password: ""
  db: 0

auth:
  jwt_secret: ""           # REQUIRED: set a strong random string (min 16 chars)
  token_expire: 24h        # JWT token expiration
  # OAuth providers (optional)
  # oauth_providers:
  #   - provider: github
  #     client_id: ""
  #     client_secret: ""
  #     redirect_url: "http://localhost:8080/api/v1/auth/oauth/github/callback"

security:
  rate_limit_default: 100
  rate_limit_owner: 200
  rate_limit_admin: 150
  rate_limit_dev: 100
  rate_limit_viewer: 50

audit:
  external_log_path: ""    # Optional: path for external audit log (JSON Lines)
  retention_days: 90       # Audit log retention period (days)

log:
  level: info               # debug, info, warn, error
  format: json              # json or text
  file: ./logs/deploypilot.log
  max_size: 100MB
  max_backups: 10
  enable_tracing: true

deploy:
  default_mode: api
  build_timeout: 10m
  health_check_interval: 30s
  health_check_retries: 3
  rollback_on_failure: true

monitor:
  enabled: true
  metrics_public: false

# 备份配置
backup:
  enabled: true
  interval: "6h"
  retention_count: 10
  retention_days: 30
  backup_dir: "data/backups"

# 暴力破解防护
bruteforce:
  max_attempts: 5
  lockout_duration: "15m"
  window_duration: "15m"
  progressive_delay: true
  base_delay: "1s"
  max_delay: "30s"
  ip_max_attempts: 20
  ip_lockout_duration: "30m"

# Grafana 集成
grafana:
  enabled: false
  url: "http://localhost:3000"
  api_key: ""
  admin_user: ""
  admin_password: ""
  annotations_enabled: true
  sync_interval: 60

# API 开放平台 (OAuth2)
api_platform:
  enabled: true
  max_clients_per_user: 10
  token_expire_hours: 24
  code_expire_minutes: 10
